<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 si atat. Doua programe foarte diferite consuma biblioteca asta - planificatorul de
         pe disc, care ruleaza pe net6.0, si modul din joc, care ruleaza pe runtime-ul net6 al lui
         MelonLoader - iar netstandard2.0 este numitorul lor comun. Rostul intregii biblioteci este ca
         normalizarea cheilor, generarea valorilor si formatul retetelor sa aiba O SINGURA implementare:
         doua copii ar aluneca una fata de alta, si atunci fiecare diferenta masurata ar fi o diferenta in
         unealta, nu in codul recuperat. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Cpp2IL.VerifyCore</AssemblyName>
    <RootNamespace>Cpp2IL.VerifyCore</RootNamespace>
    <!-- Fara dependinte NuGet, dinadins: un mod MelonLoader care trebuie sa care pachete dupa el in
         directorul Mods al jocului este un mod care nu ajunge sa fie pornit niciodata. -->
  </PropertyGroup>

</Project>
